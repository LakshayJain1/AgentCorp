  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:install": "cd desktop && npm install",
    "desktop:dev": "concurrently \"next dev\" \"cd desktop && npm run dev\"",
